# GEMINI_API_KEY: Required for server-side Gemini AI chat & pre-assessment evaluation.
# In Google AI Studio, this is automatically injected at runtime from secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Tele-MANAS Verified National Helplines (Govt. of India)
NEXT_PUBLIC_TELEMANAS_TOLLFREE="14416"
NEXT_PUBLIC_TELEMANAS_ALT="1-800-891-4416"
